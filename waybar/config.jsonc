{
  "layer": "bottom",
  "position": "top",
  "exclusive": true,
  "height": 30,
  "spacing": 8,

  "modules-left": [
    "hyprland/workspaces",
    "hyprland/window"
  ],

  "modules-center": [
    "clock"
  ],

  "modules-right": [
    "temperature",
    "custom/gpu",
    "cpu",
    "memory",
    "network",
    "pulseaudio",
    "tray"
  ],

  "hyprland/workspaces": {
    "format": "{name}",
    "on-click": "activate"
  },

  "hyprland/window": {
    "max-length": 40
  },

  "clock": {
    "format": "{:%H:%M  %d-%m-%Y}",
    // "tooltip-format": "{:%Y-%m-%d}"
  },

  "temperature": {
      "hwmon-path": "/sys/class/hwmon/hwmon1/temp1_input",
      "format": "{temperatureC}°C ",
      "critical-threshold": 85
  },

  "custom/gpu": {
      "exec": "nvidia-smi --query-gpu=utilization.gpu,temperature.gpu --format=csv,noheader,nounits | awk -F', ' '{print $1\"% | \"$2\"°C\"}'",
      "interval": 2,
      "format": "GPU {} "
  },

  "cpu": {
    "format": "CPU {usage}% "
  },

  "memory": {
    "format": "{}% "
  },

  "network": {
    "format-wifi": "{essid} ({signalStrength}%) <span font_desc='Symbols Nerd Font'></span>",
    "format-ethernet": "{ipaddr} ",
    "format-disconnected": "Disconnected ⚠"
  },

  "pulseaudio": {
    "format": "{volume}% {icon}",
    "format-muted": "Muted ",
    "on-click": "pavucontrol",
    "format-icons": {
      "default": ["", "", ""]
    }
  }
}
